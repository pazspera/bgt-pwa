server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Authelia - todo lo relacionado a auth
    location /auth/ {
        proxy_pass ${NGINX_AUTH_UPSTREAM};
        proxy_set_header Host              auth.bgt-auth.local;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
        proxy_buffering off;
    }

    # Callback OAuth2 - debe ir al frontend SPA
    location /callback {
        try_files $uri /index.html;
    }

    location /api/ {
        proxy_pass ${NGINX_API_UPSTREAM};
        proxy_set_header Host              ${NGINX_API_HOST};
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }

    location /jwks.json {
        proxy_pass ${NGINX_AUTH_UPSTREAM}jwks.json;
        proxy_set_header Host auth.bgt-auth.local;
        proxy_ssl_verify off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}